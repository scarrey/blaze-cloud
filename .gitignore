node_modules/

# The cloud database: the shop's trading history, and the branch key hashes.
# Never commit.
data/
*.db
*.db-wal
*.db-shm

# The repo root ignores package-lock.json everywhere. Deliberately overridden
# here: this is a server that gets `npm ci` on deploy, so the exact dependency
# versions must be pinned. Without the lockfile a deploy installs whatever
# minor versions happen to be current that day — which for better-sqlite3
# means a different native build than the one that was tested.
!package-lock.json

# Never commit the database credential.
.env
